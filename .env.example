# Data + Mongo
DATA_PATH=data/Churn_dataset.csv
MONGO_URI=mongodb://admin:changeme@localhost:27017/?authSource=admin
MONGO_DB=churn
MONGO_COLLECTION=customer_churn

# Spark transformation output
SPARK_OUTPUT_PATH=data/processed/transformed_churn_data.parquet
SPARK_JARS_PACKAGES=org.mongodb.spark:mongo-spark-connector_2.12:10.3.0

# MLflow
MLFLOW_TRACKING_URI=file:///absolute/path/to/Churn-Navigator/mlruns
MLFLOW_EXPERIMENT=Churn Prediction
MODEL_NAME=churn_prediction_model
MODEL_ARTIFACT_PATH=random_forest_model

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
CHURN_THRESHOLD=0.5
